<Window x:Class="CursorVault.Windows.PackCreatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Créer un pack CursorVault" Width="820" Height="720" MinWidth="720" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" FontFamily="{DynamicResource AppFontFamily}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Créateur de pack" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Le créateur original est obligatoire et restera affiché même si le pack est renommé." Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,16" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Nom du pack" Foreground="{DynamicResource MutedBrush}"/>
            <TextBox x:Name="NameBox" Grid.Row="1" Margin="0,5,0,0"/>
            <TextBlock Grid.Column="2" Text="Créateur original" Foreground="{DynamicResource MutedBrush}"/>
            <TextBox x:Name="AuthorBox" Grid.Row="1" Grid.Column="2" Margin="0,5,0,0"/>
            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="Description" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
            <TextBox x:Name="DescriptionBox" Grid.Row="3" Grid.ColumnSpan="3" Margin="0,5,0,0"/>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Associer les rôles Windows" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="4,0,0,8"/>
                <ListBox x:Name="RoleList" Grid.Row="1" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayRole}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding FileDisplay}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0"/>
                                <Button Grid.Column="2" Content="{Binding ChooseText}" Click="BrowseRole_Click" Margin="0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#E58B8B" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Click="Cancel_Click"/>
                <Button Content="CRÉER LE PACK" Click="Create_Click" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold" Margin="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
