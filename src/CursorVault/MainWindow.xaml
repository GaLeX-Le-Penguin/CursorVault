<Window x:Class="CursorVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CursorVault" Width="1420" Height="860" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" FontFamily="{DynamicResource AppFontFamily}"
        Icon="Assets/CursorVault.ico"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Grid Background="{DynamicResource WindowBrush}" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Halos très diffus uniquement visibles avec le thème Translucide. -->
        <Ellipse Grid.Row="0" Grid.RowSpan="3"
                 Width="720" Height="720"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-260,-330,0,0"
                 Fill="{DynamicResource GlassGlowBrush}"
                 IsHitTestVisible="False" Panel.ZIndex="0">
            <Ellipse.Effect>
                <BlurEffect Radius="105" KernelType="Gaussian" RenderingBias="Performance"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Grid.Row="0" Grid.RowSpan="3"
                 Width="620" Height="620"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-220,-310"
                 Fill="{DynamicResource GlassGlowSecondaryBrush}"
                 IsHitTestVisible="False" Panel.ZIndex="0">
            <Ellipse.Effect>
                <BlurEffect Radius="115" KernelType="Gaussian" RenderingBias="Performance"/>
            </Ellipse.Effect>
        </Ellipse>
        <Border Grid.Row="0" Grid.RowSpan="3"
                Height="1" VerticalAlignment="Top"
                Background="{DynamicResource GlassSheenBrush}"
                IsHitTestVisible="False" Panel.ZIndex="0"/>

        <Grid Grid.Row="0" Margin="30,14,30,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="HomeNavigationButton" GroupName="MainNavigation" Content="Accueil"
                             IsChecked="True" Style="{StaticResource MainNavigationButtonStyle}" Margin="0,0,12,0" Click="HomeNavigationButton_Click"/>
                <RadioButton x:Name="LibraryNavigationButton" GroupName="MainNavigation" Content="Bibliothèque"
                             Style="{StaticResource MainNavigationButtonStyle}" Margin="0,0,12,0" Click="LibraryNavigationButton_Click"/>
                <RadioButton x:Name="WindowsNavigationButton" GroupName="MainNavigation" Content="Curseurs Windows"
                             Style="{StaticResource MainNavigationButtonStyle}" Margin="0,0,12,0" Click="WindowsNavigationButton_Click"/>
                <RadioButton x:Name="DiagnosticNavigationButton" GroupName="MainNavigation" Content="Diagnostic"
                             Style="{StaticResource MainNavigationButtonStyle}" Margin="0,0,12,0" Click="DiagnosticNavigationButton_Click"/>
                <RadioButton x:Name="SettingsNavigationButton" GroupName="MainNavigation" Content="Paramètres"
                             Style="{StaticResource MainNavigationButtonStyle}" Margin="0" Click="SettingsNavigationButton_Click"/>
            </StackPanel>
        </Grid>

        <TabControl x:Name="MainTabs" Grid.Row="1" Style="{StaticResource ContentOnlyTabControlStyle}" SelectedIndex="0">
            <!-- ACCUEIL -->
            <TabItem Header="Accueil">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="30,22,30,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="CursorVault" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Gestionnaire de bibliothèque et de schémas de curseurs Windows" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,22,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="PACKS" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                    <TextBlock x:Name="HomePackCountText" Text="0" Foreground="{DynamicResource TextBrush}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="FAVORIS" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                    <TextBlock x:Name="HomeFavoriteCountText" Text="0" Foreground="{DynamicResource TextBrush}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="INCOMPLETS" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                    <TextBlock x:Name="HomeIncompleteCountText" Text="0" Foreground="{DynamicResource TextBrush}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="6" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="SCHÉMA ACTIF" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                    <TextBlock x:Name="HomeActiveSchemeText" Text="Windows" Foreground="{DynamicResource TextBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Actions rapides" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Les imports sont installés automatiquement dans la bibliothèque locale de CursorVault." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,16"/>
                                    <WrapPanel>
                                        <Button Content="Pack aléatoire" Click="RandomPackButton_Click"/>
                                        <Button Content="Créer un pack" Click="CreatePackButton_Click"/>
                                        <Button Content="Importer fichiers / ZIP" Click="ImportFilesButton_Click"/>
                                        <Button Content="Importer un dossier" Click="ImportFolderButton_Click"/>
                                    </WrapPanel>
                                    <Border Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Glisser-déposer" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="Dépose ici un .zip, un dossier ou plusieurs fichiers .cur / .ani depuis l’Explorateur Windows." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Favoris" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                                    <ListBox x:Name="HomeFavoriteList" Grid.Row="1" MouseDoubleClick="HomeFavoriteList_MouseDoubleClick" HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="12,9">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding CreatorLine}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding CompletenessText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="HomeStatusText" Grid.Row="3" Foreground="{DynamicResource MutedBrush}" Margin="0,18,0,0" TextWrapping="Wrap"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- BIBLIOTHÈQUE -->
            <TabItem Header="Bibliothèque">
                <Grid Margin="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="410"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Bibliothèque" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="LibraryCountText" Text="Packs installés localement" Margin="0,3,0,14" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                            <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,0,0,10" TextChanged="SearchBox_TextChanged" ToolTip="Rechercher par nom, créateur ou description"/>
                            <ComboBox x:Name="PackFilterComboBox" Grid.Row="2" Margin="0,0,0,10" SelectionChanged="PackFilterComboBox_SelectionChanged">
                                <ComboBoxItem Content="Tous"/>
                                <ComboBoxItem Content="Complets"/>
                                <ComboBoxItem Content="Incomplets"/>
                                <ComboBoxItem Content="Animés"/>
                                <ComboBoxItem Content="Statiques"/>
                                <ComboBoxItem Content="Favoris"/>
                            </ComboBox>
                            <ComboBox x:Name="LibrarySortComboBox" Grid.Row="3" Margin="0,0,0,10" SelectionChanged="LibrarySortComboBox_SelectionChanged">
                                <ComboBoxItem Content="Favoris d'abord"/>
                                <ComboBoxItem Content="Nom A-Z"/>
                                <ComboBoxItem Content="Nom Z-A"/>
                                <ComboBoxItem Content="Créateur"/>
                                <ComboBoxItem Content="Complets d'abord"/>
                                <ComboBoxItem Content="Plus récemment ajoutés"/>
                            </ComboBox>

                            <ListBox x:Name="PackList" Grid.Row="4" SelectionChanged="PackList_SelectionChanged" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ContextMenu>
                                    <ContextMenu Style="{StaticResource PackContextMenuStyle}" Opened="PackContextMenu_Opened">
                                        <MenuItem x:Name="ContextApplyMenuItem" Style="{StaticResource PackContextMenuItemStyle}" Header="Appliquer" Click="ContextApplyPack_Click">
                                            <MenuItem.Icon>
                                                <Grid Width="20" Height="20">
                                                    <TextBlock Text="✓" FontFamily="Segoe UI Symbol" FontSize="16" FontWeight="Bold" Foreground="#5CE28B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="ContextFavoriteMenuItem" Style="{StaticResource PackContextMenuItemStyle}" Header="Ajouter / retirer des favoris" Click="ContextFavoritePack_Click">
                                            <MenuItem.Icon>
                                                <Grid Width="20" Height="20">
                                                    <TextBlock x:Name="ContextFavoriteIconText" Text="☆" FontFamily="Segoe UI Symbol" FontSize="16" Foreground="#F8D66D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Style="{StaticResource PackContextSeparatorStyle}"/>
                                        <MenuItem x:Name="ContextRenameMenuItem" Style="{StaticResource PackContextMenuItemStyle}" Header="Renommer" Click="ContextRenamePack_Click">
                                            <MenuItem.Icon>
                                                <Grid Width="20" Height="20">
                                                    <TextBlock Text="✎" FontFamily="Segoe UI Symbol" FontSize="15" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="ContextOpenFolderMenuItem" Style="{StaticResource PackContextMenuItemStyle}" Header="Ouvrir le dossier" Click="ContextOpenPackFolder_Click">
                                            <MenuItem.Icon>
                                                <Grid Width="20" Height="20">
                                                    <Viewbox Width="18" Height="18" Stretch="Uniform">
                                                        <Canvas Width="24" Height="20">
                                                            <Path Fill="#F7D154" Stroke="#C89112" StrokeThickness="1.1" StrokeLineJoin="Round"
                                                                  Data="M2.2,7.0 L2.2,5.6 C2.2,4.7 2.9,4.0 3.8,4.0 L9.2,4.0 L11.0,5.6 L19.8,5.6 C20.7,5.6 21.4,6.3 21.4,7.2 L21.4,8.0 Z"/>
                                                            <Path Fill="#FFD96A" Stroke="#C89112" StrokeThickness="1.1" StrokeLineJoin="Round"
                                                                  Data="M2.0,7.5 L22.0,7.5 L20.6,16.8 C20.5,17.6 19.9,18.0 19.1,18.0 L4.2,18.0 C3.3,18.0 2.6,17.3 2.6,16.4 Z"/>
                                                            <Path Fill="#FFE38A" Opacity="0.65"
                                                                  Data="M4.1,8.4 L18.9,8.4 L17.9,15.4 L4.1,15.4 Z"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Grid>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="ContextExportMenuItem" Style="{StaticResource PackContextMenuItemStyle}" Header="Exporter en ZIP" Click="ContextExportPack_Click">
                                            <MenuItem.Icon>
                                                <Grid Width="20" Height="20">
                                                    <Image Source="Assets/export_zip.png" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Exporter install.inf" Style="{StaticResource PackContextMenuItemStyle}" Click="ContextExportInfPack_Click">
                                            <MenuItem.Icon><Grid Width="20" Height="20"><TextBlock Text="INF" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="ContextRepairMenuItem" Style="{StaticResource PackContextMenuItemStyle}" Header="Réparer les références" Click="ContextRepairPack_Click">
                                            <MenuItem.Icon>
                                                <Grid Width="20" Height="20">
                                                    <TextBlock Text="🔧" FontFamily="Segoe UI Emoji" FontSize="14" Foreground="#FFCE73" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Style="{StaticResource PackContextSeparatorStyle}"/>
                                        <MenuItem x:Name="ContextDeleteMenuItem" Style="{StaticResource PackContextMenuItemStyle}" Header="Supprimer de CursorVault" Click="ContextDeletePack_Click">
                                            <MenuItem.Icon>
                                                <Grid Width="20" Height="20">
                                                    <TextBlock Text="✕" FontFamily="Segoe UI Symbol" FontSize="16" FontWeight="Bold" Foreground="#FF6B6B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="11,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" ToolTip="{Binding Name}"/>
                                                <TextBlock Text="{Binding CreatorLine}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding CompletenessText}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock Text="{Binding VariantLine}" FontSize="10" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding FavoriteMark}" Width="42" Height="38" FontSize="18" Padding="0" Margin="8,0,0,0" Tag="{Binding}" Click="FavoriteButton_Click" ToolTip="{Binding FavoriteToolTip}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <WrapPanel Grid.Row="5" Margin="0,12,0,0">
                                <Button Content="Importer" Click="ImportFilesButton_Click"/>
                                <Button Content="Créer" Click="CreatePackButton_Click"/>
                                <Button Content="Aléatoire" Click="RandomPackButton_Click"/>
                                <Button Content="Dossier des packs" Click="OpenPacksButton_Click" Margin="0"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="PackNameText" Text="Sélectionnez un pack" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="PackMetaText" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Actualiser" Click="RefreshButton_Click" VerticalAlignment="Top" Margin="8,0,0,0"/>
                            </Grid>

                            <Border Grid.Row="1" Margin="0,18,0,16" Background="{DynamicResource PanelAltBrush}" CornerRadius="10" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="260"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="PreviewHost" Height="116" Background="{DynamicResource PreviewTintBrush}" BorderBrush="{DynamicResource PreviewBorderBrush}" BorderThickness="1" CornerRadius="10">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="APERÇU" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Survolez ici" Margin="0,7,0,0" Foreground="{DynamicResource TextBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Curseur sélectionné" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="PreviewRoleText" Text="Aucun" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="PreviewFileText" Text="Sélectionnez une ligne dans la liste." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="INFORMATIONS" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="PackInfoCreatorText" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            <TextBlock x:Name="PackInfoRolesText" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                                            <TextBlock x:Name="PackInfoFormatText" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="PackInfoVariantText" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="PackVariantSelectorLabel" Text="Variantes liées" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,3" Visibility="Collapsed"/>
                                            <ComboBox x:Name="PackVariantComboBox" DisplayMemberPath="Name" SelectionChanged="PackVariantComboBox_SelectionChanged" Visibility="Collapsed" MaxDropDownHeight="200"/>
                                            <TextBlock x:Name="PackInfoSizeText" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <DataGrid x:Name="CursorGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="CursorGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Rôle Windows" Binding="{Binding DisplayRole}" Width="180"/>
                                    <DataGridTextColumn Header="Fichier" Binding="{Binding File}" Width="*"/>
                                    <DataGridTextColumn Header="État" Binding="{Binding Status}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="3" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Text="Prêt." TextWrapping="Wrap" Margin="0,0,12,0"/>
                                <WrapPanel Grid.Column="1">
                                    <Button Content="Réparer" Click="RepairButton_Click"/>
                                    <Button Content="Exporter ZIP" Click="ExportButton_Click"/>
                                    <Button Content="Exporter install.inf" Click="ExportInfButton_Click"/>
                                    <Button Content="Analyser" Click="AnalyzePackButton_Click"/>
                                    <Button Content="Restaurer" Click="RestoreButton_Click"/>
                                    <Button Content="APPLIQUER" Click="ApplyButton_Click" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold" Margin="0"/>
                                </WrapPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- CURSEURS WINDOWS -->
            <TabItem Header="Curseurs Windows">
                <Grid Margin="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="410"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Modèles Windows" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="WindowsSchemeCountText" Text="Schémas enregistrés dans Windows" Margin="0,3,0,14" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBox x:Name="WindowsSchemeSearchBox" Grid.Row="1" Margin="0,0,0,12" TextChanged="WindowsSchemeSearchBox_TextChanged" ToolTip="Rechercher un modèle Windows"/>
                            <ListBox x:Name="WindowsSchemeList" Grid.Row="2" SelectionChanged="WindowsSchemeList_SelectionChanged" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12" MinHeight="74" Background="Transparent" CornerRadius="9">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" ToolTip="{Binding Name}"/>
                                                <Border Grid.Column="1" Margin="10,0,0,0" Width="56" Height="24" Padding="0" Background="{DynamicResource AccentBrush}" CornerRadius="6" VerticalAlignment="Top" HorizontalAlignment="Right" Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding ActiveText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                                </Border>
                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SourceDisplay}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding CursorCountText}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                                <Button Content="Menu Pointeurs" Click="OpenWindowsPointerMenu_Click"/>
                                <Button Content="Dossier Cursors" Click="OpenWindowsCursorFolder_Click"/>
                                <Button Content="Actualiser" Click="RefreshWindowsSchemesButton_Click" Margin="0"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="WindowsSchemeNameText" Text="Sélectionnez un modèle Windows" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="WindowsSchemeMetaText" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Menu Windows" Click="OpenWindowsPointerMenu_Click" VerticalAlignment="Top" Margin="8,0,0,0"/>
                            </Grid>
                            <Border Grid.Row="1" Margin="0,18,0,16" Background="{DynamicResource PanelAltBrush}" CornerRadius="10" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border x:Name="WindowsSchemePreviewHost" Height="110" Background="{DynamicResource PreviewTintBrush}" BorderBrush="{DynamicResource PreviewBorderBrush}" BorderThickness="1" CornerRadius="10">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="APERÇU" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Survolez ici" Margin="0,7,0,0" Foreground="{DynamicResource TextBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Curseur du modèle" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="WindowsSchemePreviewRoleText" Text="Aucun" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="WindowsSchemePreviewPathText" Text="Sélectionnez un rôle dans la liste." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataGrid x:Name="WindowsSchemeCursorGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="WindowsSchemeCursorGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Rôle Windows" Binding="{Binding DisplayRole}" Width="180"/>
                                    <DataGridTextColumn Header="Fichier" Binding="{Binding File}" Width="220"/>
                                    <DataGridTextColumn Header="État" Binding="{Binding Status}" Width="100"/>
                                    <DataGridTextColumn Header="Chemin" Binding="{Binding FullPath}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid Grid.Row="3" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="WindowsStatusText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Text="Prêt." TextWrapping="Wrap"/>
                                <Button Grid.Column="1" Content="APPLIQUER CE MODÈLE" Click="ApplyWindowsSchemeButton_Click" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold" Margin="8,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- DIAGNOSTIC -->
            <TabItem Header="Diagnostic">
                <Grid Margin="30,22,30,30">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Diagnostic" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="État de CursorVault, environnement Windows et utilisation du stockage." Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,18"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <TextBox x:Name="DiagnosticReportTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="DiagnosticStorageText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                        <WrapPanel Grid.Column="1">
                            <Button Content="Actualiser" Click="RefreshDiagnosticButton_Click"/>
                            <Button Content="Copier le diagnostic" Click="CopyDiagnosticButton_Click"/>
                            <Button Content="Nettoyer le cache" Click="ClearCacheButton_Click" Margin="0"/>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- PARAMÈTRES -->
            <TabItem Header="Paramètres">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="30,22,30,30" MaxWidth="1100" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Paramètres" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Configuration de l’apparence, des packs incomplets et de la rotation automatique." Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,18"/>
                        </StackPanel>

                        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="520"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Apparence" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Choisissez le thème sombre, clair ou translucide et la couleur de CursorVault." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,20,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Thème" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged" Margin="0,0,0,14">
                                        <ComboBoxItem Content="Sombre"/>
                                        <ComboBoxItem Content="Clair"/>
                                        <ComboBoxItem Content="Translucide"/>
                                    </ComboBox>
                                    <TextBlock Text="Couleur" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="AccentColorComboBox" SelectionChanged="AccentColorComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Bleu" Tag="#6EA8FE"/>
                                            <ComboBoxItem Content="Violet" Tag="#A78BFA"/>
                                            <ComboBoxItem Content="Vert" Tag="#55D69E"/>
                                            <ComboBoxItem Content="Cyan" Tag="#55C7F3"/>
                                            <ComboBoxItem Content="Orange" Tag="#FFB15C"/>
                                            <ComboBoxItem Content="Rouge" Tag="#FF6B75"/>
                                            <ComboBoxItem Content="Rose" Tag="#F277B8"/>
                                            <ComboBoxItem Content="Or" Tag="#E7C35A"/>
                                            <ComboBoxItem Content="Personnalisée" Tag="custom"/>
                                        </ComboBox>
                                        <Border x:Name="AccentColorPreview" Grid.Column="1" Width="42" Height="42" Margin="10,0,0,0"
                                                Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9"/>
                                        <Button Grid.Column="2" Content="Choisir..." Click="CustomAccentColorButton_Click" Margin="10,0,0,0" Padding="14,8"/>
                                    </Grid>
                                    <TextBlock Text="Police de l’interface" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,6"/>
                                    <ComboBox x:Name="FontFamilyComboBox" SelectionChanged="FontFamilyComboBox_SelectionChanged" MaxDropDownHeight="360">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Langue" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Langue de l’interface. Le changement est appliqué immédiatement." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,20,0"/>
                                </StackPanel>
                                <ComboBox x:Name="LanguageComboBox" Grid.Column="1" SelectionChanged="LanguageComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Automatique (Windows)" Tag="auto"/>
                                    <ComboBoxItem Content="Français" Tag="fr-FR"/>
                                    <ComboBoxItem Content="English" Tag="en-US"/>
                                    <ComboBoxItem Content="Español" Tag="es-ES"/>
                                    <ComboBoxItem Content="Deutsch" Tag="de-DE"/>
                                    <ComboBoxItem Content="Italiano" Tag="it-IT"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="520"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Intégration Windows" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Démarrage automatique et fonctionnement en arrière-plan." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,20,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <CheckBox x:Name="StartWithWindowsCheckBox" Content="Exécuter CursorVault au démarrage de Windows" Foreground="{DynamicResource TextBrush}" Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="MinimizeToTrayCheckBox" Content="Réduire CursorVault en arrière-plan dans la zone de notification" Foreground="{DynamicResource TextBrush}" Checked="MinimizeToTrayCheck_Changed" Unchecked="MinimizeToTrayCheck_Changed"/>
                                    <TextBlock Text="Quand cette option est active, Réduire masque la fenêtre. Le bouton Fermer la place aussi en arrière-plan. Utilisez Quitter CursorVault pour arrêter complètement l’application." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="24,7,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="4" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Packs incomplets" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Comportement pour les rôles absents d’un pack." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,20,0"/>
                                </StackPanel>
                                <ComboBox x:Name="MissingRoleBehaviorComboBox" Grid.Column="1" SelectionChanged="MissingRoleBehaviorComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Conserver le curseur actuel"/>
                                    <ComboBoxItem Content="Utiliser le curseur Windows par défaut"/>
                                    <ComboBoxItem Content="Choisir manuellement à l’application"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Grid.Row="5" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Rotation automatique" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="La rotation horaire ou quotidienne fonctionne pendant que CursorVault est ouvert. Le mode démarrage s’exécute à chaque lancement." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,20,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <CheckBox x:Name="RotationEnabledCheckBox" Content="Activer la rotation" Foreground="{DynamicResource TextBrush}" Checked="RotationCheck_Changed" Unchecked="RotationCheck_Changed" Margin="0,0,0,10"/>
                                    <ComboBox x:Name="RotationModeComboBox" SelectionChanged="RotationMode_SelectionChanged" Margin="0,0,0,10">
                                        <ComboBoxItem Content="Démarrage"/>
                                        <ComboBoxItem Content="Toutes les heures"/>
                                        <ComboBoxItem Content="Tous les jours"/>
                                    </ComboBox>
                                    <CheckBox x:Name="RotationFavoritesOnlyCheckBox" Content="Utiliser seulement les favoris" Foreground="{DynamicResource TextBrush}" Checked="RotationCheck_Changed" Unchecked="RotationCheck_Changed"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="6" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="520"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Thème Windows" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Applique automatiquement un pack clair ou sombre lorsque Windows change de thème." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,20,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <CheckBox x:Name="FollowWindowsThemeCheckBox" Content="Suivre le thème clair / sombre de Windows" Checked="FollowWindowsThemeCheckBox_Changed" Unchecked="FollowWindowsThemeCheckBox_Changed" Margin="0,0,0,10"/>
                                    <TextBlock Text="Pack pour le thème clair" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="LightThemePackComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="ThemePackComboBox_SelectionChanged" Margin="0,0,0,10"/>
                                    <TextBlock Text="Pack pour le thème sombre" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="DarkThemePackComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="ThemePackComboBox_SelectionChanged"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="7" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="520"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Sauvegarde et mode portable" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Exporte ou restaure toute la configuration et permet de stocker les données à côté de l'exécutable." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,20,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <WrapPanel Margin="0,0,0,10">
                                        <Button Content="Exporter une sauvegarde" Click="ExportFullBackupButton_Click"/>
                                        <Button Content="Importer une sauvegarde" Click="ImportFullBackupButton_Click" Margin="0"/>
                                    </WrapPanel>
                                    <CheckBox x:Name="PortableModeCheckBox" Content="Mode portable" Checked="PortableModeCheckBox_Changed" Unchecked="PortableModeCheckBox_Changed"/>
                                    <TextBlock Text="Le changement du mode portable prend effet au prochain démarrage." Foreground="{DynamicResource MutedBrush}" Margin="24,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="8" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="520"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Bibliothèque" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Tri des packs et taille générale de la fenêtre." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,20,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Tri par défaut" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="SettingsSortComboBox" SelectionChanged="SettingsSortComboBox_SelectionChanged" Margin="0,0,0,10">
                                        <ComboBoxItem Content="Favoris d'abord"/><ComboBoxItem Content="Nom A-Z"/><ComboBoxItem Content="Nom Z-A"/><ComboBoxItem Content="Créateur"/><ComboBoxItem Content="Complets d'abord"/><ComboBoxItem Content="Plus récemment ajoutés"/>
                                    </ComboBox>
                                    <TextBlock Text="Taille de l'interface" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="InterfaceSizeComboBox" SelectionChanged="InterfaceSizeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Compacte"/><ComboBoxItem Content="Normale"/><ComboBoxItem Content="Grande"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="9" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="520"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Diagnostic et stockage" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Informations techniques, consommation disque et nettoyage du cache temporaire." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,20,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="StorageUsageText" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <WrapPanel>
                                        <Button Content="Afficher le diagnostic" Click="ShowDiagnosticButton_Click"/>
                                        <Button Content="Copier le diagnostic" Click="CopyDiagnosticButton_Click"/>
                                        <Button Content="Nettoyer le cache" Click="ClearCacheButton_Click" Margin="0"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="10" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="520"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Mises à jour" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Vérifie automatiquement la dernière version publiée sur GitHub." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,20,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="CurrentVersionText" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Source : GitHub Releases" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
                                    <Button Content="Rechercher les mises à jour" Click="CheckUpdatesButton_Click" HorizontalAlignment="Left" Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="11" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Bibliothèque et sécurité" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Les packs importés sont copiés dans %LocalAppData%\CursorVault\Packs. Les fichiers sont vérifiés avant chaque application." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                                <WrapPanel>
                                    <Button Content="Ouvrir les données CursorVault" Click="OpenDataFolderButton_Click"/>
                                    <Button Content="Menu Pointeurs Windows" Click="OpenWindowsPointerMenu_Click"/>
                                    <Button Content="Restaurer la sauvegarde" Click="RestoreButton_Click"/>
                                    <Button Content="Quitter CursorVault" Click="QuitApplicationButton_Click" Margin="0"/>
                                </WrapPanel>
                                <TextBlock x:Name="SettingsStatusText" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="Réinitialisation" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Rétablit les paramètres d’origine de CursorVault : thème sombre, couleur bleue, police Segoe UI, langue automatique de Windows et options système par défaut. Les packs installés et les favoris sont conservés." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Réinitialiser les paramètres" Click="ResetSettingsButton_Click" VerticalAlignment="Center" Margin="0" Padding="18,10" Background="#D94A4A" BorderBrush="#FF6B75" Foreground="White"/>
                            </Grid>
                        </Border>

                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Margin="30,0,30,10" Padding="2,10,2,0"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}"
                Background="Transparent" Panel.ZIndex="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="GLX" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="  •  © 2026 GLX" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="CursorVault" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
